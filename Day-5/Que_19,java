import java.util.*;
public class assign_19 {
    //WAP to print factor of a number 
    public static void main(String args[]){
    System.out.println("Enter the number to print factor");
    Scanner sc = new Scanner(System.in);
    int n = sc.nextInt();
    System.out.println("The factor of "+n+" is:");
    for(int i=1 ; i<=n ; i++){
        if(n%i==0){
            System.out.println(i);
        }
    }
    }
}
